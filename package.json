  "packageManager": "pnpm@12.15.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rero/rero-ils-ui"
  },
  "description": "User interface for RERO integrated library system (RERO ILS).",
  "keywords": [
    "rero",
    "rero-ils",
    "invenio",
    "angular"
  ],
  "homepage": "https://github.com/rero/rero-ils-ui#readme",
  "scripts": {
    "ng": "ng",
    "start-admin-proxy": "ng serve admin --proxy-config proxy/proxy.admin.conf.json --ssl true --ssl-cert ./certificate/localhost.crt --ssl-key ./certificate/localhost.key",
    "start-public-patron-profile-proxy": "ng serve public-patron-profile --proxy-config proxy.conf.json --ssl true --ssl-cert ./certificate/localhost.crt --ssl-key ./certificate/localhost.key",
    "start-public-holdings-items-proxy": "ng serve public-holdings-items --proxy-config proxy.conf.json --ssl true --ssl-cert ./certificate/localhost.crt --ssl-key ./certificate/localhost.key",
    "start-public-search-proxy": "ng serve public-search --proxy-config proxy.conf.json --ssl true --ssl-cert ./certificate/localhost.crt --ssl-key ./certificate/localhost.key",
    "start-search-bar-proxy": "ng serve search-bar --proxy-config proxy.conf.json --ssl true --ssl-cert ./certificate/localhost.crt --ssl-key ./certificate/localhost.key",
    "build-shared": "ng build --configuration production shared",
    "build": "pnpm run build-shared && ng build admin --configuration production && ng build public-patron-profile --configuration production && ng build public-search --configuration production && ng build public-holdings-items --configuration production && ng build search-bar --configuration production",
    "pack": "./scripts/check-no-local-links.js && pnpm run build && ./scripts/dist_pkg.js -o build && cd build && pnpm pack --pack-destination ..",
    "test": "ng test",
    "lint": "ng lint --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shared_extract_messages": "ngx-translate-extract -k -c -s -i ./projects/shared/src -o ./projects/shared/translations/messages.json --fi '  '",
    "shared_update_catalog": "ngx-translate-extract -k -c -s -i ./projects/shared/src -o ./projects/shared/src/assets/rero-ils-ui/shared/i18n/{de,en,es,fr,it,nl,ar,ta,uk}.json --fi '  '",
    "admin_extract_messages": "ngx-translate-extract -k -c -s -i ./projects/admin/src -o ./projects/admin/translations/messages.json --fi '  '",
    "admin_update_catalog": "ngx-translate-extract -k -c -s -i ./projects/admin/src -o ./projects/admin/src/assets/rero-ils-ui/admin/i18n/{de,en,es,fr,it,nl,ar,ta,uk}.json --fi '  '",
    "public-search_extract_messages": "ngx-translate-extract -k -c -s -i ./projects/public-search/src -o ./projects/public-search/translations/messages.json --fi '  '",
    "public-search_update_catalog": "ngx-translate-extract -k -c -s -i ./projects/public-search/src -o ./projects/public-search/src/assets/rero-ils-ui/public-search/i18n/{de,en,es,fr,it,nl,ar,ta,uk}.json --fi '  '",
    "extract_messages": "pnpm run shared_extract_messages && pnpm run public-search_extract_messages && pnpm run admin_extract_messages",
    "update_catalog": "pnpm run shared_update_catalog && pnpm run public-search_update_catalog && pnpm run admin_update_catalog",
    "release": "semantic-release"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
